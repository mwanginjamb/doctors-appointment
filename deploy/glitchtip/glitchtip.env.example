# GlitchTip settings. Copy to glitchtip.env (not committed) and fill in.

# Long random string: openssl rand -hex 32
SECRET_KEY=change-me

# Must match POSTGRES_PASSWORD in the .env next to docker-compose.yml
DATABASE_URL=postgres://glitchtip:change-me@postgres:5432/glitchtip
REDIS_URL=redis://redis:6379/0

# The public address of GlitchTip, as served by nginx
GLITCHTIP_DOMAIN=https://errors.example.co.ke
PORT=8000

# Email for GlitchTip's own notifications (new issues). Same SMTP account as the app works:
# smtp://user:password@smtp.example.com:587
EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=errors@example.co.ke

# After creating your admin account, set this to false so nobody else can sign up
ENABLE_USER_REGISTRATION=true

# Keep error events for 90 days (they hold no personal data; see ErrorTrackerTarget::scrub())
GLITCHTIP_MAX_EVENT_LIFE_DAYS=90
