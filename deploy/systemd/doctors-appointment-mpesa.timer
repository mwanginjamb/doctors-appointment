# Fires doctors-appointment-mpesa.service every 5 minutes.
#
#   systemctl list-timers doctors-appointment-mpesa.timer   # last / next run

[Unit]
Description=Settle pending M-Pesa payments every 5 minutes
PartOf=doctors-appointment.target

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
# Missed runs need no catch-up: the next run looks at everything still pending
Persistent=false
Unit=doctors-appointment-mpesa.service

[Install]
WantedBy=doctors-appointment.target
