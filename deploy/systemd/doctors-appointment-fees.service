# One run of the commitment-fee release (php yii fee/release, F22): bookings whose hold ran out
# unpaid are released, after M-Pesa is asked about each payment still pending. Started every
# minute by doctors-appointment-fees.timer.
#
# Run it by hand:   sudo systemctl start doctors-appointment-fees
# Logs:             journalctl -u doctors-appointment-fees
#
# Same path / PHP / user assumptions as doctors-appointment-queue.service.

[Unit]
Description=Doctor appointments unpaid booking release (one run)
After=network-online.target mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/doctors-appointment
ExecStart=/usr/bin/php /var/www/html/doctors-appointment/yii fee/release --color=0
TimeoutStartSec=50

StandardOutput=journal
StandardError=journal
SyslogIdentifier=doctors-fees

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
