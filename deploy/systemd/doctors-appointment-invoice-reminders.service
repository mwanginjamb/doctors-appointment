# One run of the daily invoice reminders (php yii invoice/remind, F25 part 2): reminds each
# consultant of an invoice due today or a week overdue (email and WhatsApp), pauses patients' online
# booking with a consultant whose invoice with standard-terms charges is 14 days overdue (pilot
# statements are only reminded), and lifts pauses no longer owed. Does nothing while
# INVOICES_ENABLED=0. Started daily by doctors-appointment-invoice-reminders.timer.
#
# Run it by hand:   sudo systemctl start doctors-appointment-invoice-reminders
# Logs:             journalctl -u doctors-appointment-invoice-reminders
#
# Same path / PHP / user assumptions as doctors-appointment-queue.service.

[Unit]
Description=Doctor appointments invoice reminders and online booking pause (one run)
After=network-online.target mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/doctors-appointment
ExecStart=/usr/bin/php /var/www/html/doctors-appointment/yii invoice/remind --color=0
TimeoutStartSec=10min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=doctors-invoice-reminders

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
